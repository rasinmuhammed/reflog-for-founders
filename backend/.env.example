"""
Production-ready .env template
Copy this to .env and fill in your values
"""

# Environment
ENVIRONMENT=development  # Options: development, staging, production

# Database
DATABASE_URL=sqlite:///./reflog.db  # SQLite for dev, PostgreSQL for production

# Encryption (REQUIRED for production)
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ENCRYPTION_KEY=your_encryption_key_here

# AI API Keys
GROQ_API_KEY=gsk_your_groq_api_key_here

# Email Service (optional)
EMAIL_SERVICE_ENABLED=false
SENDGRID_API_KEY=your_sendgrid_key_here

# Frontend URL (for CORS)
FRONTEND_URL=http://localhost:3000  # Production: https://reflogapp.com

# GitHub OAuth (optional)
GITHUB_CLIENT_ID=your_github_client_id
GITHUB_CLIENT_SECRET=your_github_client_secret

# Error Tracking (production)
SENTRY_DSN=your_sentry_dsn_here

# Security
# JWT secret for session tokens (generate random string)
JWT_SECRET=your_jwt_secret_here
